{
  "name": "border-lab",
  "productName": "Border Lab",
  "version": "2.1.1",
  "description": "Photo border and EXIF annotation tool for desktop and browser.",
  "main": "main.js",
  "author": "Xiaohui",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build:web": "node tools/sync-version.cjs",
    "prestart": "node tools/sync-version.cjs",
    "predist": "node tools/sync-version.cjs",
    "predist:latest": "node tools/sync-version.cjs",
    "predist:installer": "node tools/sync-version.cjs",
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:latest": "node tools/build-latest.cjs",
    "dist:installer": "electron-builder --win nsis",
    "check:syntax": "node tools/syntax-check.cjs"
  },
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2",
    "png-to-ico": "^3.0.1",
    "rcedit": "3.1.0"
  },
  "build": {
    "appId": "com.xiaohui.borderlab",
    "productName": "Border Lab",
    "files": [
      "index.html",
      "border-lab.js",
      "styles.css",
      "vibrancy-light.css",
      "theme.js",
      "app.js",
      "edit-history.js",
      "version.js",
      "web-storage.js",
      "web-platform.js",
      "web-thumbnail-worker.js",
      "photo-picker.js",
      "thumbnail-service.cjs",
      "thumbnail-worker.cjs",
      "thumbnail-cache.cjs",
      "paper-surface.js",
      "main.js",
      "preload.js",
      "preferences.cjs",
      "assets/**/*",
      "onboarding.js"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "compression": "store",
    "win": {
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterPack": "tools/icon-after-pack.cjs"
  }
}
